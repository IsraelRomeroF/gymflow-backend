# ── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL 16. La app usa un rol NO PROPIETARIO de las tablas (ADR-001 fase 2).
DATABASE_URL="postgresql://gymflow_app:CAMBIAR@127.0.0.1:5432/gymflow_dev?schema=public"
# Rol propietario, solo para migraciones y tareas administrativas.
DATABASE_URL_MIGRATOR="postgresql://gymflow_owner:CAMBIAR@127.0.0.1:5432/gymflow_dev?schema=public"
# Base desechable que Prisma Migrate usa para reproducir el historial y
# detectar deriva. La crea `bootstrap-db.mjs`. Sin ella, `migrate diff` falla
# de forma intermitente y con un error que no señala la causa.
SHADOW_DATABASE_URL="postgresql://gymflow_owner:CAMBIAR@127.0.0.1:5432/gymflow_shadow?schema=public"

# ── Redis ────────────────────────────────────────────────────────────────────
# DOS instancias separadas (ADR-017): la de cache PUEDE desalojar, la de colas NO.
REDIS_CACHE_URL="redis://127.0.0.1:6381"
REDIS_QUEUE_URL="redis://127.0.0.1:6382"

# ── API ──────────────────────────────────────────────────────────────────────
# En local NO se arranca a mano con estos valores: `pnpm start:local` (uso real,
# gymflow_local, 3001) y `pnpm dev:pruebas` (gymflow_pruebas, 4001) ponen su
# perfil con scripts/perfil.sh, y la API se niega a arrancar si la combinación
# de base, puerto, pagos, proxies y orígenes no vale (src/platform/perfiles.ts).
API_PORT=3001
NODE_ENV=development
# Dominio padre para la cookie de sesión (ADR-004, condición 2).
SESSION_COOKIE_DOMAIN=""
SESSION_TTL_STAFF_HOURS=12
SESSION_TTL_MEMBER_DAYS=30
# Orígenes del panel y del portal. El valor de abajo es solo de desarrollo: el
# uso real no arranca con él (pone http://localhost:3003,http://localhost:3002).
CORS_ORIGINS="http://localhost:3000"
# Orígenes del portal: la única dirección de regreso tras el 3DS. Obligatoria
# en producción y en el uso real.
# PORTAL_ORIGINS=http://localhost:3002
# Proxies de confianza: solo a ellos se les cree X-Forwarded-For. En local,
# Next y el túnel corren en la misma computadora. Obligatoria en producción, en
# el uso real y con PORTAL_PUBLIC_URL.
# TRUSTED_PROXIES=127.0.0.1,::1
# Cobro con tarjeta en línea: none (el portal dice «Paga en recepción») o
# sandbox (caja de arena: solo con gymflow_pruebas, gymflow_test* o gymflow_dev).
# Sin valor: sandbox en esas bases fuera de producción; none en cualquier otra.
# PAYMENT_PROVIDER=none
# Dirección pública del portal (túnel o dominio) para los QR; la pone el modo remoto.
# PORTAL_PUBLIC_URL=

# ── Secretos ─────────────────────────────────────────────────────────────────
# Llave de los DATOS SENSIBLES: cifra las notas de salud y las plantillas del
# rostro. 32 bytes en base64. Se genera UNA vez por instalación y se respalda
# aparte de la base (doc 16 §6): perderla o cambiarla deja ilegibles esos datos.
# Antes se llamaba MFA_ENCRYPTION_KEY: si tu .env la trae con ese nombre, cámbiale
# el NOMBRE y deja el mismo valor (esta versión todavía acepta el anterior).
# Generar (solo en una instalación nueva): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SENSITIVE_DATA_KEY=""

# ── Acceso ───────────────────────────────────────────────────────────────────
# Clave PRIVADA Ed25519 (PEM) con la que se firma el padrón que descargan los
# gateways. Obligatoria en producción: un padrón sin firmar es un padrón
# falsificable, y el gateway vive en una red que el gimnasio no controla.
# Generarla con:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString())"
ROSTER_SIGNING_KEY=""
# Token del motor facial (cabecera X-Face-Token; el mismo en el motor). No se escribe a mano: lo pone motor-facial/token.sh, que también lo guarda en ~/.gymflow/uso-real.env.
FACE_SIDECAR_TOKEN=""
# Reconocimiento (bloque 2.3). El parecido mínimo y la ventaja sobre el segundo son los de fábrica
# hasta medirlos con socios del gimnasio (Biometría → Medir el reconocimiento). `branch`: el rostro
# vale en la sucursal donde se tomó; `organization`: en todo el gimnasio y la puerta decide con el plan.
# No pasar a `organization` sin la medición hecha.
# FACE_MATCH_THRESHOLD=0.38
# FACE_MATCH_MARGIN=0.05
# FACE_RECOGNITION_SCOPE=branch

# ── Límites de las rutas públicas ────────────────────────────────────────────
# Detrás de una ruta pública no hay cuenta que bloquear, así que el límite es
# la única barrera. Todas tienen valor por defecto; se declaran aquí para que
# se sepa que existen y dónde se aflojan.
#
# Quién cuenta lo decide un solo lugar: src/platform/http/rate-limit.ts. La IP
# es la REAL: solo se cree a X-Forwarded-For si viene de TRUSTED_PROXIES.
#
# Intentos POR PERSONA cada 5 minutos (el nombre es histórico): al entrar, el
# mismo correo desde la misma IP real; al firmar o cambiar la contraseña, la
# misma sesión. El bloqueo por cuenta (5 fallos) sigue aparte.
AUTH_ATTEMPTS_PER_IP=30
# Inicios de sesión desde una misma IP real, de cualquier correo, cada 5
# minutos: frena a quien prueba una contraseña contra quinientos correos.
AUTH_ATTEMPTS_PER_NETWORK=100
# Canjes del código de invitación al portal, por IP real cada 5 minutos.
PORTAL_ENROLL_ATTEMPTS=10
# Envíos del alta por QR por TELÉFONO capturado cada 10 minutos (sin teléfono,
# por correo). Nunca por red: en una promoción todos salen por la IP del gimnasio.
INTAKE_SUBMIT_ATTEMPTS=5
# Altas por QR aceptadas por SUCURSAL en una hora.
INTAKE_SUBMIT_PER_BRANCH=60
# Altas digitales sin revisar que admite una sucursal antes de cerrar el formulario público (PS-09).
INTAKE_PENDING_MAX_PER_BRANCH=200

# ── Domiciliación ────────────────────────────────────────────────────────────
# Secreto con el que se verifica la FIRMA de los webhooks del procesador.
# Es lo único que autentica esa ruta: no hay sesión detrás de un webhook, así
# que un valor débil equivale a dejar que cualquiera declare pagos cobrados.
PAYMENT_WEBHOOK_SECRET=""

# ── Base de datos: pool y tiempos límite (OPT2-03) ───────────────────────────
# DB_POOL_MAX=20
# DB_POOL_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_TX_TIMEOUT_MS=30000
# DB_LOG_QUERIES=          # 1 = emite cada consulta (solo para medir)
# SLOW_ROUTE_MS=300

# Avisos al teléfono del dueño (Web Push, DP-10). Genera el par con: npx web-push generate-vapid-keys
# Sin llaves, el panel no ofrece el botón y nada falla.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@gymflow.mx
